# Copy to .env.local; never commit populated values. Node 22 is the CI/runtime baseline.
# Required at runtime, unused during build. Migrations need DATABASE_URL exported.
DATABASE_URL=
# Generate each secret separately; AUTH_SECRET and CRON_SECRET should be random.
AUTH_SECRET=
CRON_SECRET=

# Canonical origin: at least one required; all configured values must agree.
# Use https://postial.co in production; local literal hosts allow HTTP.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Comma-separated hosts that permanently redirect to NEXT_PUBLIC_APP_URL.
REDIRECT_HOSTS=www.postial.co,postial.net,www.postial.net
# Only behind ingress that overwrites Host / forwarded headers.
AUTH_TRUST_HOST=false
# Only behind ingress that overwrites X-Real-IP; otherwise shared anonymous budgets.
APPROVAL_TRUST_PROXY=false

# Encryption: base64 of exactly 32 random bytes, server-only. Preserve read keys.
# Legacy key remains k0. Never change a key's ID or discard backup-required keys.
APP_ENCRYPTION_KEY=
# Optional ring: keyId:base64,keyId:base64 — FIRST writes, all entries read.
# Supply either the legacy key or a ring (or both for migration); see README rotation.
APP_ENCRYPTION_KEYS=

# Worker runs every 30 seconds by default. false for intentional web-only replicas.
WORKER_ENABLED=true
# Standalone HTTP listener; expose only through the trusted production ingress.
PORT=3000
HOSTNAME=0.0.0.0

# Optional Google sign-in: both required; callback /api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional email sign-in: both required; callback /api/auth/callback/nodemailer.
# Do not enable real mail delivery in verification environments.
SMTP_URL=
EMAIL_FROM=Postial <noreply@mail.mintapis.com>
# Set LEGACY_HOST_REDIRECT=1 only when the old host should 301 redirect to Postial.
LEGACY_HOST_REDIRECT=0

# Optional Stripe billing; all server-only. Keep test/live configurations separate.
# Checkout redirects need no publishable key; STRIPE_PUBLISHABLE_KEY is unused.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook, not an API key.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PORTAL_CONFIG=

# Optional X / Threads / LinkedIn / Facebook OAuth apps; both values of each pair
# enable its provider. See docs/connect-x.md, docs/connect-threads.md,
# docs/connect-linkedin.md and docs/connect-facebook.md for approval/callback setup.
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional LinkedIn REST API version (defaults to 202508).
LINKEDIN_VERSION=202508
# Optional Facebook Graph API version (defaults to v21.0).
FACEBOOK_GRAPH_VERSION=v21.0
# Bluesky, Mastodon and Telegram channel credentials are entered per channel and
# encrypted in PostgreSQL; they are not global environment variables.

# TEST ONLY: literal loopback provider mocks, ignored in production.
# X_API_BASE_URL=http://127.0.0.1:3999
# THREADS_API_BASE_URL=http://127.0.0.1:3999
# LINKEDIN_API_BASE_URL=http://127.0.0.1:3999
# FACEBOOK_API_BASE_URL=http://127.0.0.1:3999
# MEDIA_ALLOW_LOOPBACK=1
# WEBHOOK_ALLOW_LOOPBACK=1

# Verification against a migrated disposable DB (never production).
# Managed verify:http selects its own port; individual verifiers accept this origin.
# VERIFY_BASE_URL=http://localhost:3992
# Evidence stays outside the repo by default; runner resolves this to an absolute path.
# VERIFY_EVIDENCE_DIR=../work/verification
# Browser defaults to /usr/bin/google-chrome; package dependencies include Playwright/axe.
# CHROME_PATH=/usr/bin/google-chrome
# PLAYWRIGHT_MODULE=playwright
# AXE_PATH=node_modules/axe-core/axe.min.js
# Optional individual-script evidence overrides (see README inventory):
# APPROVAL_SCREENSHOT=/tmp/socialmint-approvals-mobile.png
# C8_EVIDENCE=../work/verification/fixer8-evidence
# FIXER2_EVIDENCE=../work/verification/fixer2-evidence
# FIXER3_EVIDENCE=../work/verification/fixer3-evidence
# Historical origin aliases remain supported; VERIFY_BASE_URL takes precedence:
# API_HTTP_URL= / APPROVAL_HTTP_URL= / APPSHELL_HTTP_URL= / BILLING_HTTP_URL=
# BROWSER_BASE_URL= / BULK_BROWSER_URL= / C6_HTTP_URL= / C7_HTTP_URL= / C8_HTTP_URL=
# CORE_HTTP_URL= / DOCS_HTTP_URL= / FIXER2_URL= / FIXER3_HTTP_URL=
# MARKETING_TEST_URL= / MEDIA_HTTP_URL= / TEAM_HTTP_URL= / WAITLIST_BASE_URL=
# Framework-managed NODE_ENV, NEXT_PHASE and NEXT_RUNTIME are not user configuration.
