DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_URL=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
NEXT_PUBLIC_APP_URL=
STRIPE_PORTAL_CONFIG=

# Channel encryption: base64-encoded 32 random bytes, server-only
APP_ENCRYPTION_KEY=
# Internal publishing tick authentication, server-only
CRON_SECRET=

# X/Threads OAuth (vault: SOCIALMINT_X_CLIENT_ID/SECRET, SOCIALMINT_THREADS_APP_ID/SECRET)
APP_URL=https://socialmint.app.mintapis.com
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Non-production verification only; literal loopback, ignored in production:
# X_API_BASE_URL=http://127.0.0.1:3999
# THREADS_API_BASE_URL=http://127.0.0.1:3999

# Optional versioned keyring; FIRST entry writes, all entries read. Keep legacy key as k0.
APP_ENCRYPTION_KEYS=
# Enable only behind ingress that OVERWRITES X-Real-IP; otherwise IP budgets are shared.
APPROVAL_TRUST_PROXY=false
# false only for web-only replicas / isolated verification; default worker enabled.
WORKER_ENABLED=true
